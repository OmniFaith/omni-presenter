{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "paths": {
      "/*": [
        "./src/*",
        "./src/control/*",
        "./src/viewer/*",
        "./src/chat/*",
        "./src/types/*"
      ]
    }
  },
  "include": ["src/**/*"]
}

